# ─── FRONTEND (Only anon key & client configs exposed to Vite) ───
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=https://www.aanyafashions.com/api
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Razorpay Payment Gateway — Client Configuration
# Public Key ID for Razorpay Checkout SDK (rzp_test_... for Sandbox, rzp_live_... for Live)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
VITE_MERCHANT_NAME=Aanya Fashions

# ─── BACKEND ONLY (Never exposed to Vite or browser bundle) ───
PORT=5000
NODE_ENV=development
FRONTEND_URL=https://aanyafashions.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Secret Credentials (used by server/controllers/paymentController.js)
# Generated from Razorpay Merchant Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── GOOGLE ANALYTICS 4 DATA API (Server-Side Only) ───
# Official GA4 Property ID: 561727316 (Aanya Fashions)
GA4_PROPERTY_ID=561727316
# Google Cloud Service Account with Viewer permissions on GA4 property 561727316
GA4_CLIENT_EMAIL=ga4-service-account@your-gcp-project.iam.gserviceaccount.com
# Service Account RSA Private Key (keep full PEM string including \n)
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GA4_CLIENT_ID=your_client_id_optional
