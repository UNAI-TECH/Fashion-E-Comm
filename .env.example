# ─── FRONTEND (Only anon key & client configs exposed to Vite) ───
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:5000/api

# Google Pay India (UPI Merchant Configuration)
# Your business UPI Virtual Payment Address — payments settle directly to this account
VITE_GOOGLE_PAY_VPA=aanya.fashions@okaxis
# Display name shown on Google Pay payment sheet
VITE_MERCHANT_NAME=Aanya Fashions
# Merchant Category Code (5691 = Women's Ready-to-Wear Apparel)
VITE_MERCHANT_MCC=5691

# ─── BACKEND ONLY (Never exposed to Vite or browser bundle) ───
PORT=5000
NODE_ENV=development
FRONTEND_URL=https://fashion-e-comm.vercel.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-side duplicate of merchant config (used by paymentController.js)
GOOGLE_PAY_MERCHANT_VPA=aanya.fashions@okaxis
GOOGLE_PAY_MERCHANT_NAME=Aanya Fashions
GOOGLE_PAY_MCC=5691

# Bank/PSP Transaction Status API (REQUIRED for authoritative UPI payment verification)
# Without this, UPI payments remain "Pending Verification" until manual bank reconciliation
# Obtain from your acquiring bank or PSP partner (e.g., Axis Bank merchant API)
PSP_STATUS_API_URL=
PSP_API_KEY=
