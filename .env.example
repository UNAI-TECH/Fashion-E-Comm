# ─── FRONTEND (Only anon key & client configs exposed to Vite) ───
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:5000/api

# Google Pay India — Merchant Configuration
# Business UPI VPA — payments settle directly to this bank account
VITE_GOOGLE_PAY_VPA=aanya.fashions@okaxis
# Display name on Google Pay payment sheet
VITE_MERCHANT_NAME=Aanya Fashions
# Google Pay Merchant ID (from Google Pay Business Console)
VITE_GPAY_MERCHANT_ID=BCR2DN6DRLE2N3BV
# Merchant Category Code (5137 = Uniforms & Commercial Clothing)
VITE_MERCHANT_MCC=5137

# ─── BACKEND ONLY (Never exposed to Vite or browser bundle) ───
PORT=5000
NODE_ENV=development
FRONTEND_URL=https://fashion-e-comm.vercel.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-side merchant config (used by paymentController.js)
GOOGLE_PAY_MERCHANT_VPA=aanya.fashions@okaxis
GOOGLE_PAY_MERCHANT_NAME=Aanya Fashions
GOOGLE_PAY_MCC=5137

# Bank/PSP Transaction Status API (REQUIRED for authoritative UPI payment verification)
# Without this, UPI payments remain "Pending Verification" until manual bank reconciliation
# Obtain from your acquiring bank (Axis Bank for @okaxis VPA)
PSP_STATUS_API_URL=
PSP_API_KEY=
