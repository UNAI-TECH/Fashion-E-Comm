# ─── FRONTEND (Vite Client Variables) ───
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:5000/api

# Google Pay India (UPI Merchant Configuration)
VITE_GOOGLE_PAY_VPA=aanya.fashions@okaxis
VITE_MERCHANT_NAME=Aanya Fashions
VITE_MERCHANT_MCC=5691

# Google Pay Web API (Card Payments via pay.js)
# Environment: TEST for development, PRODUCTION for live payments
VITE_GPAY_ENVIRONMENT=TEST
# Google Pay Merchant ID (required for PRODUCTION, obtain from Google Pay Business Console)
VITE_GPAY_MERCHANT_ID=
# Payment gateway name (e.g., razorpay, paytm, juspay, stripe)
VITE_GPAY_GATEWAY=example
# Gateway-specific merchant ID from your payment processor
VITE_GPAY_GATEWAY_MERCHANT_ID=exampleGatewayMerchantId

# ─── BACKEND ONLY (Never exposed to client bundle) ───
PORT=5000
NODE_ENV=development
FRONTEND_URL=https://fashion-e-comm.vercel.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Bank/PSP Transaction Status API (for authoritative UPI payment verification)
PSP_STATUS_API_URL=
PSP_API_KEY=

