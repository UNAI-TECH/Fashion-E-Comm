# ─── FRONTEND (Only anon key & client configs exposed to Vite) ───
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:5000/api

# Razorpay Payment Gateway — Client Configuration
# Public Key ID for Razorpay Checkout SDK (rzp_test_... for Sandbox, rzp_live_... for Live)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
VITE_MERCHANT_NAME=Aanya Fashions

# ─── BACKEND ONLY (Never exposed to Vite or browser bundle) ───
PORT=5000
NODE_ENV=development
FRONTEND_URL=https://fashion-e-comm.vercel.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Secret Credentials (used by server/controllers/paymentController.js)
# Generated from Razorpay Merchant Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
